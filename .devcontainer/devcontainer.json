{
  "name": "Laravel PHP 8.4 with MySQL",

  "dockerComposeFile": "compose.yaml",

  "service": "app",

  "runServices": [
    "app",
    "mysql",
    "phpmyadmin"
  ],

  "workspaceFolder": "/workspaces/PROJECT-01/project-01",

  "shutdownAction": "stopCompose",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },

  "forwardPorts": [
    8000,
    5173,
    8080
  ],

  "portsAttributes": {
    "8000": {
      "label": "Laravel",
      "onAutoForward": "openBrowser"
    },
    "5173": {
      "label": "Vite"
    },
    "8080": {
      "label": "phpMyAdmin"
    }
  }
}